# LLM provider selection
LLM_PROVIDER=anthropic                       # or "openai"

# Anthropic
ANTHROPIC_API_KEY=
MODEL_PLANNER=claude-sonnet-4-6              # Main planner (Sonnet for reasoning)
MODEL_RESPONSE=claude-haiku-4-5              # Response generator (Haiku for speed/cost)
MODEL_PREPROCESSOR=claude-haiku-4-5          # Intent + entity extraction

# OpenAI (alternate)
OPENAI_API_KEY=
OPENAI_MODEL_PLANNER=gpt-4.1
OPENAI_MODEL_RESPONSE=gpt-4.1-mini
OPENAI_MODEL_PREPROCESSOR=gpt-4.1-mini

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2             # sentence-transformers model name

# Data — paths are resolved relative to the process working directory.
# When running uvicorn from `backend/`, leave these as the defaults.
# When running from the repo root, use `backend/data` and `backend/logs/...`
DATA_DIR=data
AUDIT_LOG_PATH=logs/audit.ndjson
KB_INDEX_PATH=                                # Optional cached FAISS index

# Session and proposals
SESSION_TTL_SECONDS=1800
PROPOSAL_TTL_SECONDS=600

# Networking
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MIN=60

# MCP server
MCP_TRANSPORT=sse                             # or "stdio" for Claude Desktop
MCP_HOST=0.0.0.0
MCP_PORT=8001

# Admin
ADMIN_TOKEN=                                  # For /v1/eval/run
